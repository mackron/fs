fs_h := <../fs.h>;
fs_c := <../fs.c>;
c89thread_h :: <../../c89thread/c89thread.h>;
results_c   :: <../../refcode/results.c>;

/* Results. */
rename_results_namespace :: function(src:string) string
{
    return @(src)
        ["\bNS_"] <= "FS_"
        ["\bns_"] <= "fs_"
        ["\bfs_result_to_string\b"] <= "fs_result_description"
    ;
}

construct_result_conversion_c :: function() string
{
    content : string;
    content["$"] = @(results_c("/\* BEG result_from_errno.c \*/\R"        : "\R/\* END result_from_errno.c \*/"));
    content["$"] = "\n\n";
    content["$"] = @(results_c("/\* BEG result_from_GetLastError.c \*/\R" : "\R/\* END result_from_GetLastError.c \*/"));

    return rename_results_namespace(content);
}

fs_h("/\* BEG fs_result.h \*/\R" : "\R/\* END fs_result.h \*/") = rename_results_namespace(@(results_c("/\* BEG result.h \*/\R" : "\R/\* END result.h \*/")));
fs_h("/\* BEG fs_result_description.h \*/\R" : "\R/\* END fs_result_description.h \*/") = rename_results_namespace(@(results_c("/\* BEG result_to_string.h \*/\R" : "\R/\* END result_to_string.h \*/")));
fs_c("/\* BEG fs_result_description.c \*/\R" : "\R/\* END fs_result_description.c \*/") = rename_results_namespace(@(results_c("/\* BEG result_to_string.c \*/\R" : "\R/\* END result_to_string.c \*/")));
fs_c("/\* BEG fs_result_conversion.c \*/\R" : "\R/\* END fs_result_conversion.c \*/") = construct_result_conversion_c();


/* Threading. */
rename_c89thread_namespace :: function(src:string) string
{
    return @(src)
        ["\bC89THREAD_"]           <= "FS_"
        ["\bc89thread_"]           <= "fs_"
        ["\bc89mtx_t\b"]           <= "fs_mtx"
        ["\bc89mtx_"]              <= "fs_mtx_"
        ["\bc89thrd_success\b"]    <= "FS_SUCCESS"
        ["\bc89thrd_error\b"]      <= "FS_ERROR"
        ["\bc89thrd_busy\b"]       <= "FS_BUSY"
        ["\bc89thrd_result_from_"] <= "fs_result_from_"
        ["\bfs_handle\b"]          <= "void*"
    ;
}

convert_c89thread_basic_types :: function(src:string) string
{
    return rename_c89thread_namespace(src)
        // We don't need condition variables.
        ["(?m)^.*fs_pthread_cond_t.*\R"] <= ""

        // Some pedantic alignment fixes.
        ["  fs_pthread"]          <= "fs_pthread"
        ["fs_uintptr fs_pthread"] <= "fs_uintptr      fs_pthread"
    ;
}

convert_c89thread_mtx_h :: function(src:string) string
{
    return rename_c89thread_namespace(src)
        ["int fs_mtx_init"]     <= "FS_API fs_result fs_mtx_init"
        ["void fs_mtx_destroy"] <= "FS_API void fs_mtx_destroy"
        ["int fs_mtx_lock"]     <= "FS_API fs_result fs_mtx_lock"
        ["int fs_mtx_unlock"]   <= "FS_API fs_result fs_mtx_unlock"

        // Some functions are unused.
        ["(?m)^.*fs_mtx_timedlock.*\R"] <= ""
        ["(?m)^.*fs_mtx_trylock.*\R"] <= ""
    ;
}

convert_c89thread_mtx_c :: function(src:string) string
{
    return rename_c89thread_namespace(src)
        ["int fs_mtx_init"]     <= "FS_API fs_result fs_mtx_init"
        ["void fs_mtx_destroy"] <= "FS_API void fs_mtx_destroy"
        ["int fs_mtx_lock"]     <= "FS_API fs_result fs_mtx_lock"
        ["int fs_mtx_unlock"]   <= "FS_API fs_result fs_mtx_unlock"
    ;
}

convert_c89thread_result_from_pthread :: function(src:string) string
{
    return rename_c89thread_namespace(src)
        ["int fs_result_from_pthread"] <= "fs_result fs_result_from_pthread"
    ;
}

build_c89thread_mtx_c :: function() string
{
    win32 := convert_c89thread_mtx_c(@(c89thread_h("/\* BEG c89mtx_win32.c \*/\R"   : "\R/\* END c89mtx_win32.c \*/"  )));
    win32["\R/\* BEG fs_mtx_trylock_win32.c \*/\R"   : "\R/\* END fs_mtx_trylock_win32.c \*/\R"]   = "";
    win32["\R/\* BEG fs_mtx_timedlock_win32.c \*/\R" : "\R/\* END fs_mtx_timedlock_win32.c \*/\R"] = "";

    pthread := convert_c89thread_mtx_c(@(c89thread_h("/\* BEG c89mtx_pthread.c \*/\R" : "\R/\* END c89mtx_pthread.c \*/")));
    pthread["^"] = "\n\n";
    pthread["^"] = convert_c89thread_result_from_pthread(@(c89thread_h("/\* BEG c89thrd_result_from_pthread.c \*/\R" : "\R/\* END c89thrd_result_from_pthread.c \*/")));
    pthread["\R/\* BEG fs_mtx_trylock_pthread.c \*/\R"   : "\R/\* END fs_mtx_trylock_pthread.c \*/\R"]   = "";
    pthread["\R/\* BEG fs_mtx_timedlock_pthread.c \*/\R" : "\R/\* END fs_mtx_timedlock_pthread.c \*/\R"] = "";

    dos := convert_c89thread_mtx_c(@(c89thread_h("/\* BEG c89mtx_dos.c \*/\R" : "\R/\* END c89mtx_dos.c \*/")));
    dos["\R/\* BEG fs_mtx_trylock_dos.c \*/\R"   : "\R/\* END fs_mtx_trylock_dos.c \*/\R"]   = "";
    dos["\R/\* BEG fs_mtx_timedlock_dos.c \*/\R" : "\R/\* END fs_mtx_timedlock_dos.c \*/\R"] = "";

    result : string;

    result["$"] = "#if defined(FS_WIN32) && !defined(FS_USE_PTHREAD)\n";
    result["$"] = win32;
    result["$"] = "\n";
    result["$"] = "#elif defined(FS_DOS)\n";
    result["$"] = dos;
    result["$"] = "\n";
    result["$"] = "#else\n";
    result["$"] = pthread;
    result["$"] = "\n";
    result["$"] = "#endif";

    return result;
}

fs_h("/\* BEG fs_thread_basic_types.h \*/\R" : "\R/\* END fs_thread_basic_types.h \*/") = convert_c89thread_basic_types(@(c89thread_h("/\* BEG c89thread_basic_types.h \*/\R" : "\R/\* END c89thread_basic_types.h \*/")));
fs_h("/\* BEG fs_thread_mtx.h \*/\R" : "\R/\* END fs_thread_mtx.h \*/") = convert_c89thread_mtx_h(@(c89thread_h("/\* BEG c89thread_mtx.h \*/\R" : "\R/\* END c89thread_mtx.h \*/")));
fs_c("/\* BEG fs_thread_mtx.c \*/\R" : "\R/\* END fs_thread_mtx.c \*/") = build_c89thread_mtx_c();
